import express from 'express';
import { Pool } from 'pg';
import bcrypt from 'bcryptjs';
import jwt from 'jsonwebtoken';
import cookieParser from 'cookie-parser';
import dotenv from 'dotenv';
import multer from 'multer';
import { v4 as uuidv4 } from 'uuid';
import fs from 'fs';
import { GoogleGenAI } from "@google/genai";

dotenv.config();

const app = express();
const PORT = process.env.PORT || 3003;

// PostgreSQL Connection
const pool = new Pool({
  host: process.env.DB_HOST || 'localhost',
  port: parseInt(process.env.DB_PORT || '5432'),
  database: process.env.DB_NAME || 'runweekv3',
  user: process.env.DB_USER || 'runweekv3_user',
  password: process.env.DB_PASS || 'rwv3_secret_2024!',
});

const JWT_SECRET = process.env.JWT_SECRET || 'super-secret-jwt-key-change-me';

app.use(express.json());
app.use(cookieParser());
app.use(express.urlencoded({ extended: true }));

const upload = multer({ dest: 'uploads/' });

// Auth middleware
const authenticateToken = (req: any, res: any, next: any) => {
  const token = req.cookies.token;
  if (!token) return res.status(401).json({ error: 'Access denied' });

  try {
    const decoded = jwt.verify(token, JWT_SECRET);
    req.user = decoded;
    next();
  } catch (err) {
    res.status(401).json({ error: 'Invalid token' });
  }
};

const isAdmin = (req: any, res: any, next: any) => {
  if (req.user.role !== 'admin') return res.status(403).json({ error: 'Admin access required' });
  next();
};

// Database initialization
async function initDb() {
  try {
    console.log('Database connected successfully');
  } catch (err) {
    console.error('Database connection error:', err);
  }
}

initDb();

// Auth routes
app.post('/api/auth/register', async (req, res) => {
  try {
    const { email, password, name } = req.body;
    const hashedPassword = await bcrypt.hash(password, 10);
    
    const result = await pool.query(
      'INSERT INTO users (email, password, name) VALUES (, , ) RETURNING id, email, name, role',
      [email, hashedPassword, name]
    );
    
    const token = jwt.sign({ id: result.rows[0].id, email: result.rows[0].email, role: result.rows[0].role }, JWT_SECRET, { expiresIn: '7d' });
    res.cookie('token', token, { httpOnly: true, secure: true, sameSite: 'lax', domain: '.runweek.fr', maxAge: 7 * 24 * 60 * 60 * 1000 });
    res.json({ user: result.rows[0] });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

app.post('/api/auth/login', async (req, res) => {
  try {
    const { email, password } = req.body;
    const result = await pool.query('SELECT * FROM users WHERE email = ', [email]);
    const user = result.rows[0];
    
    if (!user || !await bcrypt.compare(password, user.password)) {
      return res.status(401).json({ error: 'Invalid credentials' });
    }

    const token = jwt.sign({ id: user.id, email: user.email, role: user.role }, JWT_SECRET, { expiresIn: '7d' });
    res.cookie('token', token, { httpOnly: true, secure: true, sameSite: 'lax', domain: '.runweek.fr', maxAge: 7 * 24 * 60 * 60 * 1000 });
    res.json({ user: { id: user.id, email: user.email, name: user.name, role: user.role } });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

app.post('/api/auth/logout', (req, res) => {
  res.clearCookie('token');
  res.json({ success: true });
});

app.get('/api/auth/me', async (req, res) => {
  const token = req.cookies.token;
  if (!token) return res.status(401).json({ error: 'Not authenticated' });

  try {
    const decoded = jwt.verify(token, JWT_SECRET) as any;
    const result = await pool.query('SELECT id, email, name, role FROM users WHERE id = ', [decoded.id]);
    const user = result.rows[0];
    if (!user) return res.status(401).json({ error: 'User not found' });
    res.json({ user });
  } catch (err: any) {
    res.status(401).json({ error: 'Invalid token' });
  }
});

// Stories routes
app.get('/api/stories', async (req, res) => {
  try {
    const type = req.query.type as string;
    let query = `
      SELECT s.*, u.name as author_name 
      FROM stories s 
      LEFT JOIN users u ON s.author_id = u.id 
      WHERE s.status = 'published'
    `;
    const params: any[] = [];

    if (type) {
      query += ' AND s.type = ';
      params.push(type);
    }

    query += ' ORDER BY s.created_at DESC';

    const result = await pool.query(query, params);
    const stories = result.rows.map(s => ({
      ...s,
      author: { name: s.author_name, avatar: `https://api.dicebear.com/7.x/avataaars/svg?seed=${s.author_name}` },
      runData: s.stats ? s.stats : null,
      imageUrl: s.image_url,
      category: s.type === 'editorial' ? 'Éditorial' : s.terrain || 'Course'
    }));
    
    res.json(stories);
  } catch (err: any) {
    console.error('Fetch stories error:', err);
    res.status(500).json({ error: `Internal server error: ${err.message || err}` });
  }
});

app.get('/api/stories/:slug', async (req, res) => {
  try {
    const result = await pool.query(
      'SELECT s.*, u.name as author_name FROM stories s LEFT JOIN users u ON s.author_id = u.id WHERE s.slug = ',
      [req.params.slug]
    );
    const story = result.rows[0];
    
    if (!story) {
      return res.status(404).json({ error: 'Story not found' });
    }

    res.json({
      ...story,
      author: { name: story.author_name, avatar: `https://api.dicebear.com/7.x/avataaars/svg?seed=${story.author_name}` },
      runData: story.stats || null,
      imageUrl: story.image_url,
      category: story.type === 'editorial' ? 'Éditorial' : story.terrain || 'Course'
    });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

// Settings routes
app.get('/api/settings/:key', async (req, res) => {
  try {
    const result = await pool.query('SELECT value FROM settings WHERE key = ', [req.params.key]);
    res.json({ value: result.rows[0]?.value || null });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

app.post('/api/settings/:key', async (req, res) => {
  try {
    const { value } = req.body;
    await pool.query('INSERT INTO settings (key, value) VALUES (, ) ON CONFLICT (key) DO UPDATE SET value = ', [req.params.key, value]);
    res.json({ success: true });
  } catch (err: any) {
    res.status(500).json({ error: err.message });
  }
});

// Ads routes
app.get('/api/ads', (req, res) => {
  const position = req.query.position as string;
  let query = "SELECT * FROM ads WHERE status = 'active'";
  const params: any[] = [];

  if (position) {
    query += ' AND position = ';
    params.push(position);
  }

  pool.query(query, params)
    .then(result => res.json(result.rows))
    .catch(err => res.status(500).json({ error: err.message }));
});

// Start server
app.listen(PORT, () => {
  console.log(`Server running on port ${PORT}`);
});
